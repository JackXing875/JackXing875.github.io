1));\n}\n\n.friend-card-wrapper:nth-child(8) .friend-card {\n  background: linear-gradient(135deg, rgba(108, 99, 255, 0.15), rgba(181, 176, 255, 0.1));\n}\n\n/* 手动添加更多渐变色 */\n.friend-card-wrapper:nth-child(9) .friend-card {\n  background: linear-gradient(135deg, rgba(255, 107, 107, 0.15), rgba(255, 234, 167, 0.1)); /* 红橙渐变 */\n}\n\n.friend-card-wrapper:nth-child(10) .friend-card {\n  background: linear-gradient(135deg, rgba(38, 198, 218, 0.15), rgba(255, 255, 141, 0.1)); /* 青黄渐变 */\n}\n\n.friend-card-wrapper:nth-child(11) .friend-card {\n  background: linear-gradient(135deg, rgba(156, 39, 176, 0.15), rgba(255, 193, 7, 0.1)); /* 紫金渐变 */\n}\n\n.friend-card-wrapper:nth-child(12) .friend-card {\n  background: linear-gradient(135deg, rgba(0, 210, 255, 0.15), rgba(58, 123, 213, 0.1)); /* 蓝青渐变 */\n}\n\n.friend-card-wrapper:nth-child(13) .friend-card {\n  background: linear-gradient(135deg, rgba(67, 233, 123, 0.15), rgba(56, 249, 215, 0.1)); /* 春日青绿 */\n}\n\n.friend-card-wrapper:nth-child(14) .friend-card {\n  background: linear-gradient(135deg, rgba(255, 65, 108, 0.15), rgba(255, 75, 43, 0.1)); /* 热情红橙 */\n}\n\n.friend-card-wrapper:nth-child(15) .friend-card {\n  background: linear-gradient(135deg, rgba(161, 140, 209, 0.15), rgba(251, 194, 235, 0.1)); /* 梦幻紫粉 */\n}\n\n.friend-card-wrapper:nth-child(16) .friend-card {\n  background: linear-gradient(135deg, rgba(253, 203, 241, 0.15), rgba(230, 222, 233, 0.1)); /* 也是一种淡雅 */\n}\n\n/* 悬停动画效果 */\n.friend-card:hover {\n  transform: translateY(-12px) scale(1.02);\n  box-shadow: \n    0 20px 60px rgba(0, 0, 0, 0.15),\n    inset 0 1px 0 rgba(255, 255, 255, 0.4);\n  border-color: rgba(255, 255, 255, 0.4);\n}\n\n/* 闪光效果 */\n.friend-card::before {\n  content: '';\n  position: absolute;\n  top: -2px;\n  left: -2px;\n  right: -2px;\n  bottom: -2px;\n  background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.4), transparent);\n  border-radius: 26px;\n  opacity: 0;\n  transition: opacity 0.3s ease;\n  pointer-events: none;\n  z-index: -1;\n}\n\n.friend-card:hover::before {\n  opacity: 1;\n  animation: shimmer 1.5s ease-in-out infinite;\n}\n\n@keyframes shimmer {\n  0% { transform: translateX(-100%) rotate(45deg); }\n  100% { transform: translateX(200%) rotate(45deg); }\n}\n\n/* 头像设计 */\n.friend-card img {\n  width: 80px;\n  height: 80px;\n  border-radius: 50%;\n  object-fit: cover;\n  margin-right: 20px;\n  flex-shrink: 0;\n  border: 3px solid rgba(255, 255, 255, 0.4);\n  box-shadow: \n    0 8px 24px rgba(0, 0, 0, 0.15),\n    inset 0 2px 4px rgba(255, 255, 255, 0.3);\n  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);\n  background: linear-gradient(135deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.1));\n}\n\n.friend-card:hover img {\n  transform: rotate(8deg) scale(1.1);\n  border-color: rgba(255, 255, 255, 0.6);\n  box-shadow: \n    0 12px 32px rgba(0, 0, 0, 0.2),\n    inset 0 2px 4px rgba(255, 255, 255, 0.4);\n}\n\n/* 信息区域 */\n.friend-card .info {\n  flex: 1;\n  position: relative;\n}\n\n.friend-card .info h3 {\n  margin: 0 0 8px 0;\n  font-size: 1.4rem;\n  font-weight: 700;\n  color: #2d3748;\n  text-shadow: 0 1px 2px rgba(255, 255, 255, 0.8);\n  transition: all 0.3s ease;\n  letter-spacing: -0.02em;\n}\n\n.friend-card:hover .info h3 {\n  transform: translateX(8px);\n  color: #1a202c;\n}\n\n.friend-card .info p {\n  margin: 0;\n  font-size: 1rem;\n  color: #4a5568;\n  font-weight: 400;\n  line-height: 1.6;\n  opacity: 0.9;\n  transition: all 0.3s ease;\n}\n\n.friend-card:hover .info p {\n  color: #2d3748;\n  opacity: 1;\n}\n\n/* 卡片包装器 - 用于悬停描述 */\n.friend-card-wrapper {\n  position: relative;\n  display: block;\n}\n\n/* 悬停描述框 - 放在卡片外部 */\n.friend-card-wrapper .description {\n  position: absolute;\n  top: -20px;\n  left: 50%;\n  transform: translateX(-50%) translateY(-100%);\n  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.9));\n  color: #2d3748;\n  padding: 16px 20px;\n  border-radius: 16px;\n  font-size: 0.9rem;\n  white-space: n